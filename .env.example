# NCL Arena — environment variables
# copy to .env.local for local dev, and paste the same values into
# Vercel Project Settings -> Environment Variables for production.

# --- Supabase ---
# https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Dashboard -> Settings -> API -> JWT Settings -> "JWT Secret"
# this MUST be the same secret Supabase uses, because we sign our own
# session tokens with it so RLS policies can read our custom claims.
SUPABASE_JWT_SECRET=

# optional. shared secret with the j4den.com worker that proxies /NCLtest.
# when set, the worker's x-ncl-client-ip header is trusted for rate limiting
# (otherwise every visitor shares the worker's IP and one rate-limit bucket).
NCL_PROXY_SECRET=

# --- Deployment path ---
# leave empty for local dev (served at http://localhost:3000).
# set to "/NCLtest" for the Vercel production deployment so every URL
# and asset is prefixed correctly when reverse-proxied from j4den.com.
NEXT_PUBLIC_BASE_PATH=
